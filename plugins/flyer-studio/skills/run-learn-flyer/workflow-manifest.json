{
  "schemaVersion": 1,
  "workflowId": "run-learn-flyer",
  "skill": "run-learn-flyer",
  "version": "1.3.0",
  "goalSeek": {
    "engine": "inline",
    "selection": "stage-common の共通判断手順。機械集計と既定閾値を保ち、AI が納品完了案件の根拠・反例・限界から改善仮説を返す",
    "fixedTemplate": false
  },
  "phases": [
    {
      "id": "L1-record",
      "step": 1,
      "title": "finalize 済みの案件から個人情報を含まない知見を台帳へ 1 行追記する",
      "dependsOn": [],
      "resourceIds": [
        "learn-script",
        "entrypoint",
        "record-schema",
        "stage-common",
        "essence"
      ],
      "output": "${FLYER_STUDIO_HOME:-~/.flyer-studio}/ledger/cases.jsonl",
      "onUnmet": "run-create-flyer"
    },
    {
      "id": "L2-report",
      "step": 2,
      "title": "台帳を機械集計し、AI が根拠と反例を解釈して限定した改善仮説を返す",
      "dependsOn": [
        "L1-record"
      ],
      "resourceIds": [
        "learn-script",
        "entrypoint",
        "record-schema",
        "essence"
      ],
      "output": "learn-report / learn-suggest の JSON と AI の仮説・適用限界を示す返却文（台帳は変更しない）",
      "onUnmet": "run-learn-flyer"
    },
    {
      "id": "L3-human-apply",
      "step": 3,
      "title": "人が仮説を採否判断し、採用する変更は別の変更作業へ渡す",
      "dependsOn": [
        "L2-report"
      ],
      "resourceIds": [
        "stage-common",
        "essence"
      ],
      "output": "人の採否と次の変更先（この skill からの規範自動書換なし）",
      "onUnmet": "run-learn-flyer"
    }
  ],
  "resources": [
    {
      "id": "learn-script",
      "kind": "script",
      "path": "../../scripts/learn.cjs",
      "phaseIds": [
        "L1-record",
        "L2-report"
      ]
    },
    {
      "id": "entrypoint",
      "kind": "script",
      "path": "../../scripts/cli.cjs",
      "phaseIds": [
        "L1-record",
        "L2-report"
      ]
    },
    {
      "id": "record-schema",
      "kind": "schema",
      "path": "../../schemas/learn-record.schema.json",
      "phaseIds": [
        "L1-record",
        "L2-report"
      ]
    },
    {
      "id": "stage-common",
      "kind": "reference",
      "path": "../../references/stage-common.md",
      "phaseIds": [
        "L1-record",
        "L3-human-apply"
      ]
    },
    {
      "id": "essence",
      "kind": "reference",
      "path": "../../references/essence.json",
      "phaseIds": [
        "L1-record",
        "L2-report",
        "L3-human-apply"
      ]
    }
  ],
  "stageDependencies": [
    "run-create-flyer:out/delivery.json complete (finalize)"
  ],
  "completionRequiresIndependentReviewer": false,
  "evaluationOnly": false
}
