{
  "name": "@harness-hub/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hub 本体 (Next.js on Cloudflare Workers)。UI + API + 認可 MW の単一 deploy unit",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:next": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "test": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:a11y": "vitest run tests/a11y",
    "test:auth-release-contract": "vitest run tests/auth-tenancy/authjs-handler.test.ts tests/auth-tenancy/tenant-oidc-signin-form.test.ts tests/auth-tenancy/authz-decision-matrix.test.ts tests/auth-tenancy/authz-entry.test.ts tests/auth-tenancy/tenant-isolation.test.ts tests/auth-tenancy/production-oidc-smoke.test.ts",
    "test:tenant-isolation": "vitest run tests/auth-tenancy/tenant-isolation.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --workspace-root exec biome check apps/hub",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:auth-gates": "node scripts/check-auth-gates.mjs",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "check:screen-states": "node scripts/check-screen-states.mjs",
    "check:dynamic-routes": "node scripts/check-dynamic-routes.mjs",
    "check:deploy-freshness": "node scripts/check-deploy-freshness.mjs",
    "test:google-font-build-fetch": "node --test scripts/check-google-font-build-fetch.test.mjs",
    "check:google-font-build-fetch": "node scripts/check-google-font-build-fetch.mjs",
    "check:vendored-fonts": "node scripts/vendor-fonts.mjs --check",
    "check:font-assets": "node scripts/check-font-assets.mjs",
    "fonts:update": "node scripts/vendor-fonts.mjs --update",
    "smoke:coverage-production": "tsx scripts/smoke-production-coverage.ts",
    "smoke:hearing-production": "tsx scripts/smoke-production-hearing.ts",
    "smoke:publish-production": "tsx scripts/smoke-production-publish.ts",
    "apply:monitoring": "node scripts/apply-better-stack-monitoring.mjs",
    "verify:slo-observation": "node scripts/verify-slo-observation.mjs",
    "local:migrate": "node scripts/local-dev.mjs migrate",
    "local:start": "node scripts/local-dev.mjs start",
    "local:status": "node scripts/local-dev.mjs status",
    "local:stop": "node scripts/local-dev.mjs stop",
    "local:restart": "node scripts/local-dev.mjs restart",
    "local:smoke": "node scripts/local-dev.mjs smoke",
    "local:cookie": "node scripts/local-dev.mjs cookie",
    "local:paths": "node scripts/local-dev.mjs paths",
    "test:local-dev": "node --test scripts/local-dev.test.mjs"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@harness-hub/db": "workspace:*",
    "@harness-hub/estimation": "workspace:*",
    "@harness-hub/inspection": "workspace:*",
    "@harness-hub/schemas": "workspace:*",
    "@harness-hub/ui": "workspace:*",
    "next": "^15.5.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.10.2",
    "jsdom": "^26.0.0",
    "playwright": "1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
