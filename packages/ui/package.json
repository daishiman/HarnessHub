{
  "name": "@harness-hub/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "共通 UI (design system)。docs/shared-layers.md §1 の正本。ビルドせず src を直接公開し、apps 側が transpilePackages で取込む",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "types": "./src/index.ts",
  "//sideEffects": "css は import すること自体が副作用 (スタイル適用) なので除外する。false のままだと webpack が未使用と見なして tokens.css を落とし、無スタイルで描画される",
  "sideEffects": ["*.css"],
  "files": [
    "src"
  ],
  "scripts": {
    "gen:tokens-css": "pnpm --workspace-root exec tsx packages/ui/scripts/generate-token-css.ts",
    "test": "vitest run --coverage",
    "test:a11y": "vitest run src/a11y",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --workspace-root exec biome check packages/ui"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
