  "observation_4": {
    "claim": "beads and none bindings are two separate runs whose recorded publication routes differ; github is recorded unreachable for a macro-only run with the schema rule that makes it so; every figure derives from the persisted tracker_binding",
    "github_unreachable": {
      "memory_only_demonstration": {
        "exit_code": 1,
        "mutation": "feat-deadline-notification-001.tracker_binding := github (github_publication.mode left at local_only)",
        "rejected": true,
        "report": {
          "implementation_readiness": "incomplete",
          "missing_sections": [],
          "schema": "/Users/dm/orca/workspaces/HarnessHub/wt-27-3/plugins/dev-graph/schemas/graph-node.schema.json",
          "valid": false,
          "violations": [
            {
              "code": "schema_violation",
              "detail": "$.github_publication.mode: not in enum ['issue', 'issue_and_projects']",
              "node": "feat-deadline-notification-001"
            }
          ]
        },
        "validator": "validate-graph-schema.py --graph - (stdin)"
      },
      "reason": "an unpublished macro node carries github_publication.mode=local_only; the graph-node schema requires tracker_binding=github to carry mode issue or issue_and_projects, and additionally restricts those modes to artifact_kind issue/task, so a feature or architecture node declaring github is rejected before it lands in the graph",
      "rule_1_lines": "1434-1459",
      "rule_1_verbatim": "      \"if\": {\n        \"properties\": {\n          \"tracker_binding\": {\n            \"const\": \"github\"\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"beads_linkage\": {\n            \"const\": null\n          },\n          \"github_publication\": {\n            \"properties\": {\n              \"mode\": {\n                \"enum\": [\n                  \"issue\",\n                  \"issue_and_projects\"\n                ]\n              }\n            }\n          }\n        }\n      }\n    },\n    {",
      "rule_2_lines": "1228-1265",
      "rule_2_verbatim": "    {\n      \"if\": {\n        \"properties\": {\n          \"github_publication\": {\n            \"properties\": {\n              \"mode\": {\n                \"enum\": [\n                  \"issue\",\n                  \"issue_and_projects\"\n                ]\n              }\n            }\n          }\n        }\n      },\n      \"then\": {\n        \"properties\": {\n          \"artifact_kind\": {\n            \"enum\": [\n              \"issue\",\n              \"task\"\n            ]\n          },\n          \"confirmation_status\": {\n            \"const\": \"confirmed\"\n          },\n          \"evaluation_status\": {\n            \"const\": \"pass\"\n          },\n          \"implementation_readiness\": {\n            \"properties\": {\n              \"status\": {\n                \"const\": \"complete\"\n              }\n            }\n          }\n        }\n      }",
      "schema_file": "plugins/dev-graph/schemas/graph-node.schema.json"
    },
